menu "Esp Talkie Configuration"

    config LED_GPIO
        int "LED GPIO number"
        range 0 33
        default 2
        help
            GPIO number (IOxx) to blink on and off the LED.

    config PUSH_BUTTON_GPIO
        int "Push Button GPIO number"
        range 0 33
        default 22
        help
            GPIO number (IOxx) to push button.

endmenu